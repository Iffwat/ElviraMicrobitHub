{
    "name": "microbithub",
    "version": "0.1.0",
    "description": "Connect a micro:bit + Cytron Motion:bit robot to the MicrobitHub dashboard over USB or Bluetooth (protocol v2, watchdog, E-stop).",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "motionbit": "github:cytrontechnologies/pxt-motionbit"
    },
    "files": [
        "README.md",
        "protocol.ts",
        "hub.ts",
        "main.ts"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "disablesVariants": [
        "mbdal"
    ],
    "preferredEditor": "blocksprj",
    "public": true,
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
